<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
	version="3.0">

	<!-- Only used by the :YadaTests:webTestDbSchema task, which replaces YadaWeb:testDbSchema and its
		YadaWeb/src/test/resources/META-INF/persistence.test.xml. Same entities, script-only generation. -->
	<persistence-unit name="yadaPersistenceUnit">
		<class>net.yadaframework.persistence.entity.YadaBrowserId</class>
		<class>net.yadaframework.persistence.entity.YadaClause</class>
		<class>net.yadaframework.persistence.entity.YadaPersistentEnum</class>
		<class>net.yadaframework.persistence.entity.YadaJob</class>
		<class>net.yadaframework.persistence.entity.YadaSavedProperty</class>
		<exclude-unlisted-classes>true</exclude-unlisted-classes>

		<properties>
			<property name="jakarta.persistence.schema-generation.database.action" value="none"/>
			<property name="jakarta.persistence.schema-generation.scripts.action" value="create"/>
			<property name="jakarta.persistence.schema-generation.scripts.create-target" value="build/schema/V1__yadatest.sql"/>
			<property name="hibernate.boot.allow_jdbc_metadata_access" value="false"/>
			<property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
			<property name="jakarta.persistence.database-product-name" value="MySQL"/>
			<property name="jakarta.persistence.database-major-version" value="8"/>
			<property name="hibernate.hbm2ddl.delimiter" value=";"/>
		</properties>
	</persistence-unit>
</persistence>
